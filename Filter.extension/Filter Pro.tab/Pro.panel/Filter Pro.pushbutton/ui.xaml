<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Pro" Height="720" Width="900" MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- ===================== TOP: PICK TOOLBAR ===================== -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="btnPick" Content="1. Pick Elements..." Click="pick_elements_click" DockPanel.Dock="Left"/>
                <Button x:Name="btnClearPick" Content="Clear" Click="clear_pick_click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="lblPickedCount" Text="No elements picked yet."
                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555555"/>
            </DockPanel>
        </Border>

        <!-- ===================== BOTTOM: LOG / STATUS ===================== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="Status:" FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                <ScrollViewer Height="54" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLog" Text="Ready." TextWrapping="Wrap" Foreground="#333333"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== MAIN TABS ===================== -->
        <TabControl x:Name="tabMain">

            <!-- ===== TAB 1: BUILD FILTER ===== -->
            <TabItem Header="Build Filter">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LEFT: Category / Family / Level -->
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <GroupBox Header="Category">
                            <ListBox x:Name="lstCategory" Height="110"/>
                        </GroupBox>
                        <GroupBox Header="Family">
                            <ListBox x:Name="lstFamily" Height="110"/>
                        </GroupBox>
                        <GroupBox Header="Level">
                            <ListBox x:Name="lstLevel" Height="110"/>
                        </GroupBox>
                        <TextBlock TextWrapping="Wrap" Foreground="#777777" FontStyle="Italic" FontSize="11"
                                   Text="Tip: Ctrl/Shift-click to select multiple values in each list. Leave a list empty to ignore that criterion."/>
                    </StackPanel>

                    <!-- RIGHT: Parameters / Schedule fields -->
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <GroupBox Header="Parameter (includes schedule fields)">
                            <StackPanel>
                                <ComboBox x:Name="cmbParam" Margin="0,0,0,6"
                                          SelectionChanged="param_selected_changed"/>
                                <ListBox x:Name="lstParamValues" Height="90"/>
                                <Button x:Name="btnAddRule" Content="Add Rule &#8595;" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" Click="add_rule_click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Active Parameter Rules (AND'ed together)">
                            <StackPanel>
                                <ListBox x:Name="lstActiveRules" Height="90" SelectionMode="Single"/>
                                <Button x:Name="btnRemoveRule" Content="Remove Selected Rule" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" Click="remove_rule_click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- BOTTOM: Outputs -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" BorderBrush="#CCCCCC"
                            BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
                        <StackPanel>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Select all elements in the active view that match the criteria above."
                                           Foreground="#555555" VerticalAlignment="Center"/>
                                <Button x:Name="btnSelectMatching" Content="2a. Select Matching Elements in View"
                                        Click="select_matching_click" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        MinWidth="240"/>
                            </DockPanel>

                            <GroupBox Header="2b. Create a native Revit View Filter (with color override)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Filter name"/>
                                        <TextBox x:Name="txtFilterName" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Override color"/>
                                        <ComboBox x:Name="cmbColor" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button x:Name="btnCreateFilter" Content="Create View Filter"
                                                Click="create_filter_click" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== TAB 2: MANAGE EXISTING VIEW FILTERS ===== -->
            <TabItem Header="Manage View Filters">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="btnRefreshFilters" Content="Refresh List" Click="refresh_filters_click" DockPanel.Dock="Left"/>
                        <TextBlock Text="View filters that exist in this project (all view filters, not just Filter Pro ones)."
                                   Foreground="#555555" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>

                    <ListBox x:Name="lstExistingFilters" Grid.Row="1" VerticalAlignment="Stretch" SelectionMode="Single"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btnSelectByFilter" Content="Select Matching Elements in View"
                                Click="select_by_existing_filter_click" MinWidth="210"/>
                        <Button x:Name="btnToggleVisibility" Content="Toggle Visibility in Active View"
                                Click="toggle_filter_visibility_click" MinWidth="200"/>
                        <Button x:Name="btnDeleteFilter" Content="Delete Filter" Click="delete_filter_click"
                                Background="#FFEDED"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
