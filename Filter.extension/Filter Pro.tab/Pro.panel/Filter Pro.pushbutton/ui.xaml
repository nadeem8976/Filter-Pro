<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Pro" Height="840" Width="980" MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <!-- so each row's name/count grid fills the full row width -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="TinyButton" TargetType="Button">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="ListSummary" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="2,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- ======================= TOP: PICK TOOLBAR ======================= -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Padding="0,0,0,8" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="btnPick" Content="1. Pick Elements..."
                        Click="pick_elements_click" DockPanel.Dock="Left" MinWidth="130"/>
                <Button x:Name="btnUseSelection" Content="Use Current Selection"
                        Click="use_selection_click" DockPanel.Dock="Left" MinWidth="140"/>
                <Button x:Name="btnClearPick" Content="Clear"
                        Click="clear_pick_click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="lblPickedCount" Text="No elements picked yet."
                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555555"/>
            </DockPanel>
        </Border>

        <!-- ======================= BOTTOM: STATUS LOG ======================= -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                Padding="0,6,0,0" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="Status:" FontWeight="SemiBold" DockPanel.Dock="Left"
                           Margin="0,0,6,0"/>
                <ScrollViewer Height="48" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLog" Text="Ready." TextWrapping="Wrap"
                               Foreground="#333333"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================ MAIN TABS ============================ -->
        <TabControl x:Name="tabMain">

            <!-- ====================== TAB 1: BUILD FILTER ====================== -->
            <TabItem Header="Build Filter">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LEFT: Category / Family / Level -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Sort lists by"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           FontWeight="Normal"/>
                                <ComboBox x:Name="cmbSort" Width="150"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="sort_changed"/>
                            </DockPanel>
                            <GroupBox Header="Category">
                                <StackPanel>
                                    <ListBox x:Name="lstCategory" Height="104"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Left" Content="All" Tag="lstCategory"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_all_click"/>
                                        <Button DockPanel.Dock="Left" Content="None" Tag="lstCategory"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_none_click"/>
                                        <TextBlock x:Name="lblCategorySummary" Text=""
                                                   Style="{StaticResource ListSummary}"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Family">
                                <StackPanel>
                                    <ListBox x:Name="lstFamily" Height="104"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Left" Content="All" Tag="lstFamily"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_all_click"/>
                                        <Button DockPanel.Dock="Left" Content="None" Tag="lstFamily"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_none_click"/>
                                        <TextBlock x:Name="lblFamilySummary" Text=""
                                                   Style="{StaticResource ListSummary}"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Level">
                                <StackPanel>
                                    <ListBox x:Name="lstLevel" Height="104"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Left" Content="All" Tag="lstLevel"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_all_click"/>
                                        <Button DockPanel.Dock="Left" Content="None" Tag="lstLevel"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_none_click"/>
                                        <TextBlock x:Name="lblLevelSummary" Text=""
                                                   Style="{StaticResource ListSummary}"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                            <TextBlock TextWrapping="Wrap" Foreground="#777777"
                                       FontStyle="Italic" FontSize="11"
                                       Text="Tick to keep, untick to exclude - like Revit's own Filter dialog. The number on the right is how many of your picked elements have that value. Click None to ignore an axis entirely. These three are always combined with AND."/>
                        </StackPanel>

                        <!-- RIGHT: Parameters and rules -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <GroupBox Header="Parameter (every instance and type field, i.e. every schedule field)">
                                <StackPanel>
                                    <ComboBox x:Name="cmbParam" Margin="0,0,0,6"
                                              SelectionChanged="param_selected_changed"/>
                                    <ListBox x:Name="lstParamValues" Height="96"
                                             SelectionChanged="param_value_selection_changed"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Left" Content="All" Tag="lstParamValues"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_all_click"/>
                                        <Button DockPanel.Dock="Left" Content="None" Tag="lstParamValues"
                                                Style="{StaticResource TinyButton}"
                                                Click="check_none_click"/>
                                        <TextBlock x:Name="lblValueSummary" Text=""
                                                   Style="{StaticResource ListSummary}"/>
                                    </DockPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Operator"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="1" x:Name="cmbOperator"
                                                  SelectionChanged="operator_changed"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Value"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" x:Name="txtRuleValue"/>
                                    </Grid>
                                    <TextBlock x:Name="lblValueHint" Margin="0,4,0,0"
                                               TextWrapping="Wrap" FontSize="11"
                                               FontStyle="Italic" Foreground="#777777"
                                               Text="Pick one or more values from the list."/>
                                    <Button x:Name="btnAddRule" Content="Add Rule"
                                            Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Click="add_rule_click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Active parameter rules">
                                <StackPanel>
                                    <ComboBox x:Name="cmbCombine" Margin="0,0,0,6"/>
                                    <ListBox x:Name="lstActiveRules" Height="86"
                                             SelectionMode="Single"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="btnRemoveRule" Content="Remove Selected"
                                                Click="remove_rule_click" MinWidth="120"/>
                                        <Button x:Name="btnClearRules" Content="Clear All"
                                                Click="clear_rules_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- BOTTOM: the two outputs -->
                        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                                Margin="0,8,0,0" Padding="0,10,0,0">
                            <StackPanel>

                                <GroupBox Header="2a. Work with the matching elements in the active view">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnCountMatching" Content="Count Matching"
                                                Click="count_matching_click" MinWidth="120"/>
                                        <Button x:Name="btnSelectMatching" Content="Select Matching"
                                                Click="select_matching_click" MinWidth="120"/>
                                        <Button x:Name="btnIsolateMatching" Content="Isolate Matching"
                                                Click="isolate_matching_click" MinWidth="120"/>
                                        <Button x:Name="btnResetIsolate" Content="Reset Isolate"
                                                Click="reset_isolate_click" MinWidth="100"/>
                                        <TextBlock x:Name="lblMatchCount" Text=""
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   FontWeight="Bold" Foreground="#0052CC"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="2b. Create a native Revit View Filter">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="340"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- name and the action button -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Filter name" FontWeight="Normal"/>
                                            <TextBox x:Name="txtFilterName" Margin="0,2,0,0"/>
                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                       FontWeight="Normal" FontSize="11"
                                                       FontStyle="Italic" Foreground="#777777"
                                                       Text="Leave blank for an auto-generated, timestamped name."/>
                                            <Button x:Name="btnCreateFilter" Content="Create View Filter"
                                                    Click="create_filter_click" Margin="0,10,0,0"
                                                    HorizontalAlignment="Left" MinWidth="150"/>
                                        </StackPanel>

                                        <!-- colour picker -->
                                        <GroupBox Grid.Column="1" Header="Override colour"
                                                  Margin="0,0,10,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Rectangle x:Name="rectSwatch" Width="44" Height="22"
                                                               Stroke="#888888" StrokeThickness="1"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="cmbColorPreset" Width="96"
                                                              Margin="6,0,0,0" VerticalAlignment="Center"
                                                              SelectionChanged="color_preset_changed"/>
                                                    <TextBox x:Name="txtHex" Width="80" Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             TextChanged="hex_text_changed"/>
                                                    <Button x:Name="btnCustomColor" Content="More..."
                                                            Click="custom_color_click" MinWidth="60"
                                                            Margin="6,0,0,0"/>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R"
                                                               FontWeight="Normal" VerticalAlignment="Center"/>
                                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="sliderR"
                                                            Minimum="0" Maximum="255" SmallChange="1"
                                                            LargeChange="16" IsSnapToTickEnabled="True"
                                                            TickFrequency="1" VerticalAlignment="Center"
                                                            ValueChanged="color_slider_changed"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblR"
                                                               Text="255" FontWeight="Normal"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G"
                                                               FontWeight="Normal" VerticalAlignment="Center"/>
                                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="sliderG"
                                                            Minimum="0" Maximum="255" SmallChange="1"
                                                            LargeChange="16" IsSnapToTickEnabled="True"
                                                            TickFrequency="1" VerticalAlignment="Center"
                                                            ValueChanged="color_slider_changed"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lblG"
                                                               Text="0" FontWeight="Normal"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B"
                                                               FontWeight="Normal" VerticalAlignment="Center"/>
                                                    <Slider Grid.Row="2" Grid.Column="1" x:Name="sliderB"
                                                            Minimum="0" Maximum="255" SmallChange="1"
                                                            LargeChange="16" IsSnapToTickEnabled="True"
                                                            TickFrequency="1" VerticalAlignment="Center"
                                                            ValueChanged="color_slider_changed"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lblB"
                                                               Text="0" FontWeight="Normal"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- graphic override options -->
                                        <GroupBox Grid.Column="2" Header="Override options">
                                            <StackPanel>
                                                <TextBlock Text="Line weight" FontWeight="Normal"/>
                                                <ComboBox x:Name="cmbLineWeight" Margin="0,2,0,6"/>
                                                <CheckBox x:Name="chkSolidFill" Content="Solid fill surface"
                                                          IsChecked="True"/>
                                                <CheckBox x:Name="chkApplyCut" Content="Apply to cut too"
                                                          IsChecked="True"/>
                                                <CheckBox x:Name="chkHalftone" Content="Halftone"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: MANAGE EXISTING FILTERS ================= -->
            <TabItem Header="Manage View Filters">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="btnRefreshFilters" Content="Refresh List"
                                Click="refresh_filters_click" DockPanel.Dock="Left"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555555"
                                   Text="Every view filter in this project, not only the ones Filter Pro made."/>
                    </DockPanel>

                    <ListBox x:Name="lstExistingFilters" Grid.Row="1"
                             VerticalAlignment="Stretch" SelectionMode="Single"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btnSelectByFilter" Content="Select Matching in View"
                                Click="select_by_existing_filter_click" MinWidth="170"/>
                        <Button x:Name="btnToggleVisibility" Content="Toggle Visibility in View"
                                Click="toggle_filter_visibility_click" MinWidth="170"/>
                        <Button x:Name="btnRenameFilter" Content="Rename"
                                Click="rename_filter_click"/>
                        <Button x:Name="btnDeleteFilter" Content="Delete Filter"
                                Click="delete_filter_click" Background="#FFEDED"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
